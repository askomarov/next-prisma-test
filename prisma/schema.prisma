generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TransactionKind {
  INCOME
  EXPENSE
}

enum MoneyType {
  REAL
  VIRTUAL
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  role             Role             @default(USER)
  assistantEnabled Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  transactions     Transaction[]
  wallets          Wallet[]
  categories       Category[]
  preferences      UserPreferences?
}

model Wallet {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  currency             String            @db.Char(3)
  description          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  transactions         Transaction[]
  defaultForUsers      UserPreferences[]

  @@unique([userId, name])
  @@index([userId])
}

model UserPreferences {
  userId           String           @id
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultWalletId  String?
  defaultWallet    Wallet?          @relation(fields: [defaultWalletId], references: [id], onDelete: SetNull)
  defaultMoneyType MoneyType?
  defaultKind      TransactionKind?
  updatedAt        DateTime         @updatedAt
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         TransactionKind
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]

  @@unique([userId, name, kind])
  @@index([userId, kind])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind        TransactionKind
  moneyType   MoneyType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  occurredAt  DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, occurredAt(sort: Desc)])
  @@index([walletId])
  @@index([categoryId])
}
